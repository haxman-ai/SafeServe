{% extends 'base.html.twig' %}
{% import '_shared/_macros.html.twig' as platMacros %}
{% block title %}Menu de la semaine{% endblock %}
{% block body %}

<div class="container mt-4">
    <div class="d-flex justify-content-center align-items-center mb-3">
        <h4 class="mb-0">Menu de la semaine</h4>
        <a href="{{ path('app_menu_new') }}" class="btn btn-sm btn-outline-success ms-2">+ Ajouter un menu</a>
    </div>
    
    <ul class="nav nav-tabs flex-nowrap flex-md-wrap" role="tablist">
        {% set jours = ['lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi'] %}
        {% for jour in jours %}
            <li class="nav-item" role="presentation">
                <a class="nav-link {{ loop.first ? 'active' : '' }}" data-bs-toggle="tab" href="#{{ jour }}" role="tab">
                    {{ jour|capitalize }} {{ semaine[loop.index0].format('d/m/Y') }}
                </a>
            </li>
        {% endfor %}
    </ul>

    <div class="tab-content mt-3">
        {% set jours_num = {'lundi': 1, 'mardi': 2, 'mercredi': 3, 'jeudi': 4, 'vendredi': 5} %}
        {% for jour, num in jours_num %}
            <div class="tab-pane fade {{ loop.first ? 'show active' : '' }}" id="{{ jour }}" role="tabpanel">
                {% set menu_du_jour = null %}
                {% for m in menu %}
                    {% if m.servedAt.format('N')|number_format == num %}
                        {% set menu_du_jour = m %}
                    {% endif %} 
                {% endfor %}

                {% if menu_du_jour %}
                    <div class="card text-white border-info bg-dark" style="max-width: 350px;">
                        <div class="card-body p-3">
                            {% if menu_du_jour.platsByType('entree') is not empty %}
                                <p class="mb-2">
                                    <strong>🥗 Entrée :</strong>
                                    {% for p in menu_du_jour.platsByType('entree') %}
                                        {{ p.name }}{{ platMacros.emoji('entree') }}{% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                </p>
                            {% endif %}

                            {% if menu_du_jour.platsByType('plat') is not empty %}
                                <p class="mb-2">
                                    <strong>🍽️ Plat :</strong>
                                    {% for p in menu_du_jour.platsByType('plat') %}
                                        {{ p.name }}{{ platMacros.emoji('plat') }}{% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                </p>
                            {% endif %}

                            {% if menu_du_jour.platsByType('dessert') is not empty %}
                                <p class="mb-0">
                                    <strong>🍰 Dessert :</strong>
                                    {% for p in menu_du_jour.platsByType('dessert') %}
                                        {{ p.name }}{{ platMacros.emoji('dessert') }}{% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                </p>
                            {% endif %}
                        </div>
                    </div>
                {% else %}
                    <p class="text-muted fst-italic">Aucun menu pour ce jour.</p>
                {% endif %}
            </div>
        {% endfor %}
    </div>

    <br>

    <div class="table-responsive-sm">
        <table class="table table-bordered border border-info table-hover table-sm col3">
            <thead>
                <tr class="table-active">
                    <th>Date</th>
                    <th>Entrée</th>
                    <th>Plat</th>
                    <th>Dessert</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for m in menu %}
                    <tr class="table-active">
                        <td>{{ m.servedAt|date('d/m/Y') }}</td>
                        <td>{% for p in m.platsByType('entree') %}{{ p.name }}{{ platMacros.emoji('entree') }}{% endfor %} 🥗</td>
                        <td>{% for p in m.platsByType('plat') %}{{ p.name }}{{ platMacros.emoji('plat') }}{% endfor %} 🍽️</td>
                        <td>{% for p in m.platsByType('dessert') %}{{ p.name }}{{ platMacros.emoji('dessert') }}{% endfor %} 🍰</td>
                        <td>
                            <form method="post" action="{{ path('app_menu_delete', {id: m.id}) }}">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Supprimer</button>
                            </form>
                        </td>
                        <td>
                            <a href="{{ path('app_menu_edit', {id: m.id}) }}" class="btn btn-sm btn-outline-warning">Modifier</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6"><p>Aucun menu</p></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <div class="d-flex justify-content-between mb-2">
            <a href="{{ path('app_menu', {semaine: app.request.query.get('semaine', 0) - 1}) }}" class="btn btn-sm btn-outline-primary">← Semaine précédente</a>
            <a href="{{ path('app_menu', {semaine: app.request.query.get('semaine', 0) + 1}) }}" class="btn btn-sm btn-outline-primary">Semaine suivante →</a>
        </div>
    </div>
</div>
{% endblock %}
