{% extends 'base.html.twig' %}
{% import '_shared/_macros.html.twig' as platMacros %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-center align-items-center mb-3">
        <a href="{{ path('app_menu') }}" class="btn btn-sm btn-outline-secondary">← Retour aux menus</a>
    </div>

    <div class="table-responsive-sm">
        <table class="table table-bordered border border-info table table-hover">
            <thead>
                <tr class="table-active">
                    <th>conformites</th>
                    <th>Plat</th>
                    <th>Températures</th>
                    <th>Heure</th>
                    <th>Date</th>
                    <th>User</th>
                </tr>
            </thead>
            <tbody>
                {% for t in temp %}
                    <tr class="table-active">
                        <td>
                            {% if conformites[t.id] %}
                                <span class="badge bg-success">conforme</span>
                            {% else %}
                                <span class="badge bg-danger">non conforme</span>
                            {% endif %}
                        </td>
                        <td>{{ t.plat }}{{ platMacros.emoji(t.plat.type) }}</td>
                        <td>{{ t.temperature }}</td>
                        <td>{{ t.releveAT|date('H:i') }}</td>
                        <td>{{ t.releveAT|date('d/m/Y') }}</td>
                        <td>{{ t.user.email }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">Aucune température enregistrée.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="d-flex gap-3">
        <div class="card text-white body border-danger p-3 bg-dark" id="alert-non-conforme" style="width:300px">
            <strong>Non conformes : <span id="count-non-conforme"></span></strong>
        </div>
        <div class="card text-white body border-success p-3 bg-dark" id="alert-conforme" style="width:300px">
            <strong>Conformes : <span id="count-conforme"></span></strong>
        </div>
    </div>

    <script>
        document.addEventListener('turbo:load', function() {
            const nonConformeCount = document.querySelectorAll('.bg-danger').length;
            const conformeCount = document.querySelectorAll('.bg-success').length;
            document.getElementById('count-non-conforme').textContent = nonConformeCount;
            document.getElementById('count-conforme').textContent = conformeCount;
        });
    </script>

    <br>
    {{ knp_pagination_render(temp) }}
{% endblock %}
