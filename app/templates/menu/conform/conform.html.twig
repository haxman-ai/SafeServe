{% extends 'base.html.twig' %}
{% import '_shared/_macros.html.twig' as platMacros %}

{% block body %}
<div class="container mt-4">
    <div class="page-heading mb-4">
        <div>
            <p class="page-eyebrow mb-1">Contrôle HACCP</p>
            <h1 class="h3 mb-1">Conformité des températures</h1>
            <p class="text-body-secondary mb-0">Détail des mesures et de leur statut.</p>
        </div>
        <a href="{{ path('app_menu') }}" class="btn btn-outline-secondary">← Retour aux menus</a>
    </div>

    <div class="table-card mb-4">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 temperature-table">
            <thead>
                <tr>
                    <th>Conformité</th>
                    <th>Plat</th>
                    <th>Températures</th>
                    <th>Heure</th>
                    <th>Date</th>
                    <th>Cuisinier</th>
                </tr>
            </thead>
            <tbody>
                {% for t in temp %}
                    <tr class="{{ conformites[t.id] ? 'temperature-row--ok' : 'temperature-row--alert' }}">
                        <td>
                            {% if conformites[t.id] %}
                                <span class="badge rounded-pill text-bg-success"><span aria-hidden="true">✓</span> Conforme</span>
                            {% else %}
                                <span class="badge rounded-pill text-bg-danger"><span aria-hidden="true">!</span> Non conforme</span>
                            {% endif %}
                        </td>
                        <td>{{ t.plat }}{{ platMacros.emoji(t.plat.type) }}</td>
                        <td class="temperature-value">{{ t.temperature }} <span>°C</span></td>
                        <td>{{ t.releveAT|date('H:i') }}</td>
                        <td>{{ t.releveAT|date('d/m/Y') }}</td>
                        <td>{{ t.user.email }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">Aucune température enregistrée.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
      </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-lg-4">
          <div class="card h-100 border-danger-subtle" id="alert-non-conforme">
            <div class="card-body">
            <strong>Non conformes : <span id="count-non-conforme"></span></strong>
            </div>
          </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
          <div class="card h-100 border-success-subtle" id="alert-conforme">
            <div class="card-body">
            <strong>Conformes : <span id="count-conforme"></span></strong>
            </div>
          </div>
        </div>
    </div>

    <script>
        document.addEventListener('turbo:load', function() {
            const nonConformeCount = document.querySelectorAll('.temperature-row--alert').length;
            const conformeCount = document.querySelectorAll('.temperature-row--ok').length;
            document.getElementById('count-non-conforme').textContent = nonConformeCount;
            document.getElementById('count-conforme').textContent = conformeCount;
        });
    </script>

    {{ knp_pagination_render(temp) }}
{% endblock %}
