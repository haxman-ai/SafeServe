{% extends 'base.html.twig' %}
{% import '_shared/_macros.html.twig' as platMacros %}
{% block title %}Menus de la semaine{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="page-heading mb-4">
        <div>
            <p class="page-eyebrow mb-1">À la carte</p>
            <h1 class="h3 mb-1">Menus de la semaine</h1>
            <p class="text-body-secondary mb-0">Du {{ semaineDebut|date('d/m') }} au {{ semaineFin|date('d/m/Y') }} · Plats prévus et relevés à effectuer.</p>
        </div>
        <a href="{{ path('app_temp') }}" class="btn btn-outline-secondary">← Températures</a>
    </div>

    <div class="week-navigation mb-4">
        <a href="{{ path('app_temp_menu', {semaine: app.request.query.get('semaine', 0) - 1}) }}" class="btn btn-outline-primary">← Semaine précédente</a>
        <span class="week-navigation__label">Semaine sélectionnée</span>
        <a href="{{ path('app_temp_menu', {semaine: app.request.query.get('semaine', 0) + 1}) }}" class="btn btn-outline-primary">Semaine suivante →</a>
    </div>

    {% if menu is empty %}
        <div class="empty-state-card">
            <span class="empty-state-card__icon" aria-hidden="true">🍽️</span>
            <h2 class="h5">Aucun menu cette semaine</h2>
            <p class="text-body-secondary mb-0">Les menus apparaîtront ici dès qu’ils seront enregistrés.</p>
        </div>
    {% else %}
        <div class="row g-3">
            {% for m in menu %}
            <div class="col-12 col-md-6 col-xl-4">
                <article class="card menu-day-card h-100 {{ m.servedAt|date('Y/m/d') == 'now'|date('Y/m/d') ? 'menu-day-card--today' : '' }}">
                    <div class="card-header menu-day-card__header">
                        <div>
                            {% set jours_fr = {'1': 'Lundi', '2': 'Mardi', '3': 'Mercredi', '4': 'Jeudi', '5': 'Vendredi'} %}
                            <p class="menu-day-card__weekday mb-0">{{ jours_fr[m.servedAt.format('N')] }}</p>
                            <time datetime="{{ m.servedAt|date('Y-m-d') }}">{{ m.servedAt|date('d/m/Y') }}</time>
                        </div>
                        {% if m.servedAt|date('Y/m/d') == "now"|date('Y/m/d') %}
                            <a href="{{ path('app_temp_new', {'menu': m.id}) }}" class="btn btn-sm btn-primary">🌡️ Relever</a>
                        {% endif %}
                    </div>
                    <div class="card-body">
                        {% if m.platsByType('entree') is not empty %}
                        <p class="menu-day-card__dish">
                            <strong>Entrée</strong>
                            {% for p in m.platsByType('entree') %}
                                <span>{{ p.name }}{{ platMacros.emoji('entree') }}</span>{% if not loop.last %}<span>, </span>{% endif %}
                            {% endfor %}
                        </p>
                        {% endif %}

                        {% if m.platsByType('plat') is not empty %}
                        <p class="menu-day-card__dish">
                            <strong>Plat</strong>
                            {% for p in m.platsByType('plat') %}
                                <span>{{ p.name }}{{ platMacros.emoji('plat') }}</span>{% if not loop.last %}<span>, </span>{% endif %}
                            {% endfor %}
                        </p>
                        {% endif %}

                        {% if m.platsByType('dessert') is not empty %}
                        <p class="menu-day-card__dish mb-0">
                            <strong>Dessert</strong>
                            {% for p in m.platsByType('dessert') %}
                                <span>{{ p.name }}{{ platMacros.emoji('dessert') }}</span>{% if not loop.last %}<span>, </span>{% endif %}
                            {% endfor %}
                        </p>
                        {% endif %}
                    </div>
                </article>
            </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
