{% extends 'base.html.twig' %}

{% block title %}{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-center align-items-center mb-3">
        <h4 class="mb-0">Feuille de temperatures</h4>
        <a href="{{ path('app_temp_new') }}" class="btn btn-sm btn-success ms-2">+prise des temperatures</a>
    </div>
<table class="table table-striped">
<thead>
    <tr>
        <th>Plat</th>
        <th>Températures</th>
        <th>Heure</th>
        <th>Date</th>
        <th>User</th>
    </tr>
</thead>
<tbody>
    {% for t in temp %}
    <tr>
    <td>{{t.plat}}</td>
    <td>{{t.temperature}}</td>
    <td>{{ t.releveAT|date('H:i') }}</td>
    <td>{{ t.releveAT|date('d/m/Y') }}</td>
    <td>{{t.user.email}}</td>
    </tr>
    {% else %}
    <tr>
    <td colspan="5"><p>Aucun releves de temperature</p></td>
    </tr>
  {% endfor %}
</tbody>
</table>
{% endblock %}
