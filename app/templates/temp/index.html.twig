{% extends 'base.html.twig' %}


{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-center align-items-center mb-3">
        <h4 class="mb-0">Feuille de temperatures</h4>
    </div>
<table class="table table-bordered border border-warning">
<thead>
    <tr>
        <th>conformites</th>
        <th>Plat</th>
        <th>Températures</th>
        <th>Heure</th>
        <th>Date</th>
        <th>User</th>
    </tr>
</thead>
<tbody>
    {% for t in temp %}
    <tr>
        <td>
            {% if conformites[t.id] %}
            <span class="badge bg-success">conforme</span>
            {% else %}
            <span class="badge bg-danger">non conforme</span>
            {% endif %}
        </td>
        <td>{{ t.plat }}</td>
        <td>{{ t.temperature }}</td>
        <td>{{ t.releveAT|date('H:i') }}</td>
        <td>{{ t.releveAT|date('d/m/Y') }}</td>
        <td>{{ t.user.email }}</td>
    </tr>
    {% else %}
    <tr>
        <td colspan="6">Aucune température enregistrée.</td>
    </tr>
    {% endfor %}
</tbody>
</table>

{{ knp_pagination_render(temp) }}

{% endblock %}
