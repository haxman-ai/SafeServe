{% extends 'base.html.twig' %}
{% block title %}Safeserv · Traçabilité HACCP{% endblock %}
{% block body %}
    <section class="home-hero">
        <div class="container home-hero__content">
            <span class="badge rounded-pill home-hero__badge">HACCP <span aria-hidden="true">·</span> Restauration collective <span aria-hidden="true">·</span> Traçabilité</span>
            <h1 class="display-5 fw-bold mt-3 mb-3">La traçabilité des températures, <span>simple et fiable.</span></h1>
            <p class="home-hero__lead mb-0">Safeserv remplace le cahier papier HACCP : saisie en cuisine, suivi de conformité et historique des relevés au même endroit.</p>
        </div>
    </section>

    <section class="container home-features">
        <div class="text-center mb-4">
            <p class="page-eyebrow mb-1">Un outil pour votre équipe</p>
            <h2 class="h3 mb-0">Chacun retrouve l’essentiel</h2>
        </div>

        <div class="row g-4 justify-content-center">
            <div class="col-12 col-md-6 col-lg-5">
                <article class="card home-feature-card h-100">
                    <div class="card-body p-4">
                        <span class="home-feature-card__icon" aria-hidden="true">🧑‍🍳</span>
                        <h3 class="h5 mt-3">Pour l’équipe en cuisine</h3>
                        <ul class="home-feature-list mb-0">
                            <li>Saisir les températures par plat</li>
                            <li>Repérer les relevés conformes et ceux à vérifier</li>
                            <li>Consulter les menus de la semaine</li>
                        </ul>
                    </div>
                </article>
            </div>

            <div class="col-12 col-md-6 col-lg-5">
                <article class="card home-feature-card h-100">
                    <div class="card-body p-4">
                        <span class="home-feature-card__icon" aria-hidden="true">📋</span>
                        <h3 class="h5 mt-3">Pour les responsables</h3>
                        <ul class="home-feature-list mb-0">
                            <li>Créer et modifier les menus</li>
                            <li>Suivre les relevés et leur conformité</li>
                            <li>Consulter l’historique des températures</li>
                        </ul>
                    </div>
                </article>
            </div>
        </div>
    </section>
{% endblock %}
